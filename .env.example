# ==============================================================================
# Salesforce AppExchange Partner Scraper - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust the values as needed:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
# ==============================================================================

# Salesforce WebRuntime Apex Execution API Endpoint URL
API_URL=https://findpartners.salesforce.com/webruntime/api/apex/execute?language=en-US&asGuest=true&htmlEncode=false

# HTTP Request Timeout (in seconds)
REQUEST_TIMEOUT=30
