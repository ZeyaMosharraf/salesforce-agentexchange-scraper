# ==============================================================================
# Salesforce AppExchange Partner Scraper - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust the values as needed:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
# ==============================================================================

# AppExchange Discovery Recommendations REST API Endpoint
API_URL=https://api.appexchange.salesforce.com/recommendations/v3/listings

# HTTP Request Timeout (in seconds)
REQUEST_TIMEOUT=30

# Maximum Concurrent Scraping Threads
MAX_WORKERS=8
