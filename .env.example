# ==============================================================================
# Salesforce AppExchange Partner Scraper - Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust the values as needed:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
# ==============================================================================

# Engine Strategy Selector: 'modern' (AppExchange v3 REST API ~2,150) or 'legacy' (FindPartners Apex API ~1,998)
DATA_SOURCE=modern

# Modern AppExchange Discovery Recommendations API Endpoint (v3)
MODERN_API_URL=https://api.appexchange.salesforce.com/recommendations/v3/listings

# Legacy Salesforce WebRuntime Apex Execution API Endpoint URL
API_URL=https://findpartners.salesforce.com/webruntime/api/apex/execute?language=en-US&asGuest=true&htmlEncode=false

# HTTP Request Timeout (in seconds)
REQUEST_TIMEOUT=30
